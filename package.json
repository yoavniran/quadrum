{
  "name": "quadrum-monorepo",
  "private": true,
  "description": "Monorepo for quadrum, an MIT, zero-dependency chess board renderer for the web, and its React bindings",
  "license": "MIT",
  "author": "Yoav Niran",
  "homepage": "https://github.com/yoavniran/quadrum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoavniran/quadrum.git"
  },
  "bugs": {
    "url": "https://github.com/yoavniran/quadrum/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter quadrum-demo dev",
    "build": "pnpm --filter quadrum --filter quadrum-react run build",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "bench": "pnpm --filter quadrum-bench bench",
    "bench:quick": "pnpm --filter quadrum-bench bench:quick",
    "bench:gate": "node .github/scripts/write-bench-report.mjs gate",
    "bench:summarize": "node .github/scripts/write-bench-report.mjs summarize",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
