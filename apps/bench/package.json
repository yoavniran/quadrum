{
	"name": "quadrum-bench",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite --port 5373 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5373 --strictPort",
		"bench": "node runner/run.ts",
		"bench:quick": "node runner/run.ts --runs 1 --throttle 1",
		"bench:profile": "node runner/profile.ts",
		"heap-profile": "node runner/heap-profile.ts",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.runner.json"
	},
	"dependencies": {
		"quadrum": "workspace:*"
	},
	"devDependencies": {
		"@lichess-org/chessground": "10.1.1",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.2.0",
		"overweight": "^2.2.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.1"
	}
}
