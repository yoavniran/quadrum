{
  "name": "quadrum-react",
  "version": "0.3.0",
  "description": "React bindings for the quadrum chess board renderer",
  "license": "MIT",
  "author": "Yoav Niran",
  "homepage": "https://github.com/yoavniran/quadrum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoavniran/quadrum.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/yoavniran/quadrum/issues"
  },
  "keywords": [
    "chess",
    "chessboard",
    "react",
    "quadrum",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "quadrum": ">=0.1.0 <1",
    "react": ">=18"
  },
  "devDependencies": {
    "quadrum": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
